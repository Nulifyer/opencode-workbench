{
  "nodeModulesDir": "auto",
  "imports": {
    "@opencode-workbench/shared": "./packages/shared/src/index.ts",
    "jsonc-parser": "npm:jsonc-parser@3.3.1",
    "markdown-it": "npm:markdown-it@14.1.0"
  },
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "build": "deno run -A scripts/build.ts",
    "check": "deno check packages/shared/src/index.ts packages/opencode-plugin/src/index.ts scripts/build.ts scripts/package.ts scripts/install.ts scripts/local-version.ts scripts/release.ts && deno run -A ./node_modules/typescript/lib/tsc.js -p packages/vscode-extension/tsconfig.json",
    "test": "deno task test:synthetic",
    "test:synthetic": "deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 --ignore=packages/vscode-extension/test/opencode_integration_test.ts packages/shared/test packages/opencode-plugin/tests packages/vscode-extension/test",
    "test:integration:synthetic": "deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 packages/opencode-plugin/tests/goal_integration_test.ts packages/vscode-extension/test/communication_test.ts packages/vscode-extension/test/managed-server_test.ts packages/vscode-extension/test/event_pipeline_stress_test.ts",
    "test:integration:real": "deno task build && deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 packages/vscode-extension/test/opencode_integration_test.ts",
    "test:opencode": "deno task test:integration:real",
    "test:stress": "deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 packages/vscode-extension/test/ordered-event-bus_test.ts packages/vscode-extension/test/latest-update-pump_test.ts packages/vscode-extension/test/event_pipeline_stress_test.ts",
    "test:stress:repeat": "deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 --repeats=4 packages/vscode-extension/test/ordered-event-bus_test.ts packages/vscode-extension/test/latest-update-pump_test.ts packages/vscode-extension/test/event_pipeline_stress_test.ts",
    "package": "deno task build && deno run -A scripts/package.ts",
    "release": "deno task verify && deno run -A scripts/release.ts",
    "install:local": "deno task build && deno run -A scripts/install.ts",
    "verify": "deno task check && deno task test && deno task package"
  }
}
