{
  "nodeModulesDir": "auto",
  "imports": {
    "@opencode-workbench/shared": "./packages/shared/src/index.ts",
    "jsonc-parser": "npm:jsonc-parser@3.3.1",
    "markdown-it": "npm:markdown-it@14.2.0"
  },
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "build": "deno run -A scripts/build.ts",
    "check": "deno check --sloppy-imports packages/shared/src/index.ts packages/opencode-plugin/src/index.ts scripts/build.ts scripts/package.ts scripts/install.ts scripts/local-version.ts scripts/release.ts scripts/record-opencode-acp-contract.ts scripts/probe-vscode-agent-host.ts scripts/record-opencode-verifier-contract.ts scripts/generate-protocol-artifacts.ts && deno run --allow-read scripts/generate-protocol-artifacts.ts --check && deno run -A ./node_modules/typescript/lib/tsc.js -p packages/vscode-extension/tsconfig.json",
    "test": "deno task test:synthetic",
    "test:synthetic": "deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 --ignore=packages/vscode-extension/test/opencode_integration_test.ts packages/shared/test packages/opencode-plugin/tests packages/vscode-extension/test",
    "test:integration:synthetic": "deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 packages/opencode-plugin/tests/goal_integration_test.ts packages/vscode-extension/test/communication_test.ts packages/vscode-extension/test/managed-server_test.ts packages/vscode-extension/test/event_pipeline_stress_test.ts",
    "test:integration:real": "deno task build && deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 packages/vscode-extension/test/opencode_integration_test.ts",
    "test:integration:acp": "deno task build && deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 packages/vscode-extension/test/acp_contract_test.ts",
    "test:integration:verifier": "deno task build && deno test --sloppy-imports -A packages/vscode-extension/test/verifier_contract_test.ts",
    "test:integration:agent-host": "deno test --sloppy-imports --allow-env --allow-read --allow-run packages/vscode-extension/test/agent_host_feasibility_test.ts",
    "test:harness:ux": "deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 packages/shared/test/lifecycle_test.ts packages/shared/test/event_stream_test.ts packages/opencode-plugin/tests/goal_integration_test.ts packages/vscode-extension/test/client_test.ts packages/vscode-extension/test/communication_test.ts packages/vscode-extension/test/session-controller_test.ts packages/vscode-extension/test/context_service_test.ts packages/vscode-extension/test/context_receipt_builders_test.ts packages/vscode-extension/test/browser_context_service_test.ts packages/vscode-extension/test/handoff_continuity_service_test.ts packages/vscode-extension/test/serialized_state_writer_test.ts packages/vscode-extension/test/process_lock_test.ts packages/vscode-extension/test/isolated_worktree_identity_test.ts packages/vscode-extension/test/bridge_containment_test.ts packages/vscode-extension/test/worktree_service_test.ts packages/vscode-extension/test/run_group_service_test.ts packages/vscode-extension/test/session_turn_outcome_test.ts packages/vscode-extension/test/run_observation_service_test.ts packages/vscode-extension/test/fusion_service_test.ts packages/vscode-extension/test/diff_evidence_test.ts packages/vscode-extension/test/diff_navigation_test.ts packages/vscode-extension/test/task_evidence_service_test.ts packages/vscode-extension/test/diagnostics_evidence_service_test.ts packages/vscode-extension/test/goal_verifier_service_test.ts packages/vscode-extension/test/goal_verifier_invocation_test.ts packages/vscode-extension/test/native_integration_service_test.ts packages/vscode-extension/test/session_list_view_test.ts packages/vscode-extension/test/conversation_view_test.ts packages/vscode-extension/test/inspector_presentation_test.ts packages/vscode-extension/test/menu_navigation_test.ts packages/vscode-extension/test/error_presentation_test.ts packages/vscode-extension/test/webview-assets_test.ts packages/vscode-extension/test/webview_transport_test.ts packages/vscode-extension/test/webview_snapshot_projector_test.ts",
    "test:opencode": "deno task test:integration:real",
    "test:stress": "deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 packages/vscode-extension/test/ordered-event-bus_test.ts packages/vscode-extension/test/latest-update-pump_test.ts packages/vscode-extension/test/event_pipeline_stress_test.ts packages/vscode-extension/test/webview_snapshot_projector_test.ts",
    "test:stress:repeat": "deno test --sloppy-imports --allow-env --allow-read --allow-write --allow-sys --allow-run --allow-net=127.0.0.1 --repeats=5 packages/vscode-extension/test/ordered-event-bus_test.ts packages/vscode-extension/test/latest-update-pump_test.ts packages/vscode-extension/test/event_pipeline_stress_test.ts packages/vscode-extension/test/webview_snapshot_projector_test.ts",
    "test:release": "deno task test:integration:synthetic && deno task test:harness:ux && deno task test:stress:repeat",
    "package": "deno task build && deno run -A scripts/package.ts",
    "record:acp-contract": "deno task build && deno run -A scripts/record-opencode-acp-contract.ts",
    "probe:agent-host": "deno run --allow-read --allow-write --allow-run scripts/probe-vscode-agent-host.ts",
    "record:verifier-contract": "deno task build && deno run -A scripts/record-opencode-verifier-contract.ts",
    "generate:protocol": "deno run --allow-read --allow-write scripts/generate-protocol-artifacts.ts",
    "release": "deno task verify && deno task test:release && deno run -A scripts/release.ts",
    "install:local": "deno task build && deno run -A scripts/install.ts",
    "verify": "deno task check && deno task test && deno task package"
  }
}
