      "value": {
        "protocol": 2,
        "kind": "request",
        "id": "request-1",
        "type": "session.create",
        "expectedRevision": 4,
        "mutationID": "mutation-1",
        "payload": { "draft": "" }
      }
    },
    {
      "name": "ordered event",
      "value": {
        "protocol": 2,
        "kind": "event",
        "epoch": "epoch-1",
