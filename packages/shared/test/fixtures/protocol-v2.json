        "payload": { "baseRevision": 4, "nextRevision": 5 }
      }
    },
    {
      "name": "structured overload response",
      "value": {
        "protocol": 2,
        "kind": "response",
        "id": "request-2",
        "ok": false,
        "error": {
          "code": "OVERLOADED",
          "message": "Host request queue is full",
          "retryable": true,
          "details": { "retryAfterMilliseconds": 250 }
        }
      }
    }
