{
  "name": "opencode-workbench",
  "displayName": "OpenCode Workbench",
  "description": "Native VS Code sessions and chat powered by your OpenCode installation.",
  "version": "0.4.1",
  "publisher": "nulifyer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nulifyer/opencode-workbench",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/nulifyer/opencode-workbench/issues"
  },
  "homepage": "https://github.com/nulifyer/opencode-workbench#readme",
  "keywords": [
    "opencode",
    "vscode",
    "ai",
    "chat",
    "coding-agent"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/nulifyer.opencode-workbench",
      "href": "https://marketplace.visualstudio.com/items?itemName=nulifyer.opencode-workbench",
      "description": "Visual Studio Marketplace version"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/i/nulifyer.opencode-workbench",
      "href": "https://marketplace.visualstudio.com/items?itemName=nulifyer.opencode-workbench",
      "description": "Visual Studio Marketplace installs"
    }
  ],
  "icon": "media/opencodeWorkbench.png",
  "files": [
    "dist/**",
    "media/**",
    "DESIGN.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": ["Other", "Machine Learning"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "OpenCode loads workspace configuration and can execute permission-approved tools."
    }
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:opencodeWorkbench.chat",
    "onWebviewPanel:opencodeWorkbench.chatEditor",
    "onCommand:opencodeWorkbench.openChat",
    "onCommand:opencodeWorkbench.openChatInEditor",
    "onCommand:opencodeWorkbench.newSession",
    "onCommand:opencodeWorkbench.refresh",
    "onCommand:opencodeWorkbench.deleteSession",
    "onCommand:opencodeWorkbench.abortSession",
    "onCommand:opencodeWorkbench.launchTerminal",
    "onCommand:opencodeWorkbench.attachResource",
    "onCommand:opencodeWorkbench.setServerPassword"
  ],
  "contributes": {
    "commands": [
      { "command": "opencodeWorkbench.openChat", "title": "OpenCode: Open Chat", "icon": "$(sparkle)" },
      { "command": "opencodeWorkbench.openChatInEditor", "title": "OpenCode: Open Chat in Editor", "icon": "$(open-preview)" },
      { "command": "opencodeWorkbench.newSession", "title": "OpenCode: New Session", "icon": "$(add)" },
      { "command": "opencodeWorkbench.refresh", "title": "OpenCode: Refresh", "icon": "$(refresh)" },
      { "command": "opencodeWorkbench.deleteSession", "title": "OpenCode: Delete Session", "icon": "$(trash)" },
      { "command": "opencodeWorkbench.abortSession", "title": "OpenCode: Abort Active Session", "icon": "$(debug-stop)" },
      { "command": "opencodeWorkbench.launchTerminal", "title": "OpenCode: Launch in Terminal" },
      { "command": "opencodeWorkbench.attachResource", "title": "OpenCode: Add to Chat", "icon": "$(attach)" },
      { "command": "opencodeWorkbench.setServerPassword", "title": "OpenCode: Set External Server Password" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "opencodeWorkbench.attachResource", "group": "navigation@90", "when": "resourceScheme == file" }
      ],
      "editor/title/context": [
        { "command": "opencodeWorkbench.attachResource", "group": "navigation@90", "when": "resourceScheme == file || resourceScheme == untitled" }
      ]
    },
    "configuration": {
      "title": "OpenCode Workbench",
      "properties": {
        "opencodeWorkbench.serverMode": {
          "type": "string",
          "enum": ["managed", "external"],
          "enumDescriptions": ["Start a private OpenCode server for this VS Code window.", "Connect to a separately managed OpenCode server."],
          "default": "managed",
          "scope": "machine",
          "description": "Managed mode works automatically with an installed OpenCode executable. External mode uses the server connection settings below."
        },
        "opencodeWorkbench.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the OpenCode executable in managed mode. An empty value searches VS Code's PATH."
        },
        "opencodeWorkbench.managedServerStartupTimeout": {
          "type": "integer",
          "default": 120,
          "minimum": 5,
          "maximum": 600,
          "scope": "machine",
          "description": "Seconds to wait for the managed OpenCode server to start. Increase this on slower systems."
        },
        "opencodeWorkbench.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4096",
          "scope": "machine",
          "description": "URL used in external server mode."
        },
        "opencodeWorkbench.serverUsername": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "External server HTTP Basic authentication username. An empty value reads OPENCODE_SERVER_USERNAME from the environment file."
        },
        "opencodeWorkbench.serverEnvironmentFile": {
          "type": "string",
          "default": "~/.config/opencode-workbench/server.env",
          "scope": "machine",
          "description": "Optional owner-only credentials file for external server mode. Secret Storage takes precedence."
        }
      }
    },
    "keybindings": [
      {
        "command": "opencodeWorkbench.newSession",
        "key": "ctrl+alt+n",
        "mac": "ctrl+alt+n"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencodeWorkbench",
          "title": "OpenCode",
          "icon": "media/opencodeWorkbench.svg"
        }
      ]
    },
    "views": {
      "opencodeWorkbench": [
        { "id": "opencodeWorkbench.chat", "name": "Chat", "type": "webview", "visibility": "visible", "initialSize": 4 }
      ]
    }
  },
  "scripts": {
    "build": "node ./esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "deno test --sloppy-imports test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "1.106.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
